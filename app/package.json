{
  "name": "@comet/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cargo run --manifest-path native/Cargo.toml",
    "build": "cargo build --release --manifest-path native/Cargo.toml",
    "typecheck": "cargo check --manifest-path native/Cargo.toml",
    "lint": "cargo clippy --manifest-path native/Cargo.toml --all-targets",
    "lint:fix": "cargo clippy --fix --allow-dirty --manifest-path native/Cargo.toml",
    "format": "cargo fmt --manifest-path native/Cargo.toml",
    "format:check": "cargo fmt --check --manifest-path native/Cargo.toml",
    "test": "cargo test --manifest-path native/Cargo.toml",
    "test:screenshots": "cargo test --manifest-path native/Cargo.toml --test screenshots --test editor_interactions",
    "test:screenshots:gpu": "ICED_TEST_BACKEND=wgpu cargo test --manifest-path native/Cargo.toml --test screenshots --test editor_interactions -- --test-threads=1",
    "test:screenshots:update": "UPDATE_SCREENSHOTS=1 cargo test --manifest-path native/Cargo.toml --test screenshots --test editor_interactions",
    "seed:db": "sh ./scripts/seed-db.sh",
    "bundle": "pnpm build && python3 scripts/package-native.py"
  }
}
